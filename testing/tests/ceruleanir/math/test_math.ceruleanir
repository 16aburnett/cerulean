// Testing math correctness
// Author: Amy Burnett
//========================================================================


//========================================================================

function i32 @main ()
{
    block entry {
        call @__builtin__println__char__1 (ptr("%x = add (i32(10), i32(7))"))
        %x0 = add (i32(10), i32(7))
        call @__builtin__print__char__1 (ptr("=> "))
        call @__builtin__println__int32 (i32(%x0))

        call @__builtin__println__char__1 (ptr("%x = add (f32(3.14), f32(100.5))"))
        %x1 = add (f32(3.14), f32(100.5))
        call @__builtin__print__char__1 (ptr("=> "))
        call @__builtin__println__float32 (f32(%x1))

        call @__builtin__println__char__1 (ptr("%x = sub (i32(10), i32(7))"))
        %x2 = sub (i32(10), i32(7))
        call @__builtin__print__char__1 (ptr("=> "))
        call @__builtin__println__int32 (i32(%x2))

        call @__builtin__println__char__1 (ptr("%x = sub (f32(3.14), f32(100.5))"))
        %x3 = sub (f32(3.14), f32(100.5))
        call @__builtin__print__char__1 (ptr("=> "))
        call @__builtin__println__float32 (f32(%x3))

        call @__builtin__println__char__1 (ptr("%x = mul (i32(10), i32(7))"))
        %x4 = mul (i32(10), i32(7))
        call @__builtin__print__char__1 (ptr("=> "))
        call @__builtin__println__int32 (i32(%x4))

        call @__builtin__println__char__1 (ptr("%x = mul (f32(3.14), f32(100.5))"))
        %x5 = mul (f32(3.14), f32(100.5))
        call @__builtin__print__char__1 (ptr("=> "))
        call @__builtin__println__float32 (f32(%x5))

        call @__builtin__println__char__1 (ptr("%x = div (i32(10), i32(7))"))
        %x6 = div (i32(10), i32(7))
        call @__builtin__print__char__1 (ptr("=> "))
        call @__builtin__println__int32 (i32(%x6))

        call @__builtin__println__char__1 (ptr("%x = div (f32(3.14), f32(100.5))"))
        %x7 = div (f32(3.14), f32(100.5))
        call @__builtin__print__char__1 (ptr("=> "))
        call @__builtin__println__float32 (f32(%x7))
        return (i32(0))
    }
}