// Hello World example 5 - introducing multi-file programs
// This example adds more complexity by moving the print string function
// to a separate file, requiring both files to be compiled and linked
// together.
// Author: Amy Burnett
//========================================================================
// Forward Declarations - Functions that are defined outside this file

// Need to decide on forward declaration syntax - should have a special keyword
extern function void @println_string (ptr(%string_ptr), i32(%string_length));

//========================================================================

function i32 @main () {
    block entry {
        %greeting = value (ptr("Hello, World!"))
        %length = value(i32(13))
        call @println_string (ptr(%greeting), i32(%length))
        return (i32(0))
    }
}
