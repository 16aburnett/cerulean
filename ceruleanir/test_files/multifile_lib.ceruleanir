function i32 @add_numbers (i32(%a), i32(%b)) {
    block entry {
        %result = add (i32(%a), i32(%b))
        return (i32(%result))
    }
}

function i32 @multiply_numbers (i32(%x), i32(%y)) {
    block entry {
        %result = mul (i32(%x), i32(%y))
        return (i32(%result))
    }
}
