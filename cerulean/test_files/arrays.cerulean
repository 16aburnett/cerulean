// Cerulean is a C style programming language
// Author: Amy Burnett
//========================================================================

function void fill (i32[] array, i32 N, i32 value)
{
    for (i32 i = 0; i < N; i = i + 1)
        array[i] = i * value;
}

//========================================================================

function void print (i32[] array, i32 N)
{
    print ("[");
    print (array[0]);
    for (i32 i = 1; i < N; i = i + 1)
    {
        print (", ");
        print (array[i]);
    }
    println ("]");
}

//========================================================================

function i32 main ()
{
    // Allocating arrays on the heap
    i32 N = 10;
    i32[] values = heapalloc (i32, N);

    // Assign array values
    fill (values, N, 7);

    // Read + print array values
    print (values, N);

    // Deallocate memory for array
    free (values);

    return 0;
}
