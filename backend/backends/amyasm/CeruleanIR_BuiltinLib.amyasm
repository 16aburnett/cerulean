//========================================================================
// Prints a newline to the console
// void println ();
__builtin__println:
    println 
    return 0

//========================================================================
// grabs input from the console 
// char[] input ();
__builtin__input:
    input __line
    return __line

//========================================================================
// exits/stops the program 
__builtin__exit:
    halt

//========================================================================

// Exits the program with the given exit code 
// void exit(i32 exit_code)
// - exit_code : 
__builtin__exit__i32:
    // ** not implemented for amyasm
    halt

//========================================================================
// returns default f32 value
// f32 f32 ();
__builtin__f32:
    return 0.0

//========================================================================
// returns default f64 value
// f64 f64 ();
__builtin__f64:
    return 0.0

//========================================================================
// converts i32 to f32
// f32 i32Tof32 (i32);
__builtin__i32Tof32__i32:
    stackget val 0
    itof res val
    return res

//========================================================================
// converts i64 to f64
// f64 i64Tof64 (i64);
__builtin__i64Tof64__i64:
    stackget val 0
    itof res val
    return res

//========================================================================
// parses a f32 from a given char[]
// f32 stringTof32 (char[]);
__builtin__stringTof32__char__1:
    stackget val 0
    stof res val
    return res

//========================================================================
// parses a f64 from a given char[]
