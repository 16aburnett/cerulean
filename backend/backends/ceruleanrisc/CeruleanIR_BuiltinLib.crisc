// Prints a f32 to the screen
// Utilizes printf "%f"
// void print (f32 valueToPrint);
// valueToPrint : [rbp + 16]
__builtin__print__f32:
__builtin__print__f32__function_prologue:
    push      bp        // save caller's bp
    add64i    bp, sp, 0 // bp = sp
    push      r10       // save caller's r10
    push      r1        // save caller's r1
    push      r2        // save caller's r2
    push      r3        // save caller's r3
    push      r4        // save caller's r4
    push      r5        // save caller's r5
    push      r6        // save caller's r6
    push      r7        // save caller's r7
    push      r8        // save caller's r8
    push      r9        // save caller's r9

    // Load f32 argument from the stack slot
    loadu32    r1, bp, 16 // r1 = input f32 value (f) (e.g., 3.14)

    // --- Step 1: Handle Sign (Negative) ---
    addf32    r2, r0, r0 // r2 = 0.0f
    ltf32     r4, r1, r2 // r4 = (r1 < 0.0f) ? 1 : 0
    
    loada     r5, __builtin__print__f32__extract_whole
    beq       r4, r0, r5 // If r4 == 0 (f >= 0.0f), skip negation

    add64i    r4, r0, 45 // Clear and load ASCII '-'
    putchar   r4
    subf32    r1, r2, r1 // r1 = 0.0f - r1 (negate f32 value)

__builtin__print__f32__extract_whole:
    // --- Step 2: Extract and Print Whole Number Integer Part FIRST ---
    cvtf32i32 r3, r1    // r3 = (int)f  (e.g., 3)
    
    // Call your integer printer routine using your working push/pop convention
    push      r3         // Pushed argument goes to bp + 16 inside target
    loada     r5, __builtin__print__i32
    call      r5         // Invoke print_int(3)
    pop       r3         // Clean up stack slot

    // --- Step 3: Print Decimal Point ---
    add64i    r4, r0, 46  // Clear and load ASCII '.'
    putchar   r4

    // --- Step 4: Convert Fraction to a 6-digit Integer ---
    cvti32f32 r2, r3     // r2 = (f32)int_part (e.g., 3.0f)
    subf32    r1, r1, r2 // r1 = f - int_part (e.g., 3.14 - 3.0 = 0.14)

    // Mathematically construct f32 1000000.0f directly in r6
    add64i    r6, r0, 0  
    lui       r6, 15     
    lli       r6, 16960  // r6 = integer 1000000
    cvti32f32 r6, r6     // r6 = 1000000.0f

    mulf32    r1, r1, r6 // r1 = 0.14 * 1000000.0f = 140000.0f
    cvtf32i32 r1, r1    // r1 = standard integer fraction (e.g., 140000)

    // Set up our single forward-extraction printing loop
    add64i    r2, r0, 1     
    lui       r2, 1         
    lli       r2, 34464     // r2 = 100000 (Our forward division factor)
    
    add64i    r3, r0, 0     // Clear r3 completely
    lli       r3, 6         // r3 (loop counter) = 6 digits total
    add64i    r8, r0, 1     // Constant 1 for loop decrementing

// --- Step 5: Single Forward Digit Extraction Loop ---
__builtin__print__f32__print_loop:
    loada     r5, __builtin__print__f32__function_epilogue
    beq       r3, r0, r5    // After 6 prints, finish up

    // Extract the highest digit forward
    divu32    r4, r1, r2    // r4 = 140000 / 100000 = 1
    modu32    r1, r1, r2    // r1 = 140000 % 100000 = 40000

    // Print the isolated digit
    add32i    r4, r4, 48    // Convert to ASCII
    putchar   r4

    // Scale our division factor down by 10 for the next position
    divu32i   r2, r2, 10    // 100000 -> 10000

    // Decrement loop counter safely without negative immediates
    sub32     r3, r3, r8    // r3 = r3 - 1
    loada     r5, __builtin__print__f32__print_loop
    jmp       r5

__builtin__print__f32__function_epilogue:
    pop       r9         
    pop       r8         
    pop       r7         
    pop       r6         
    pop       r5         
    pop       r4         
    pop       r3         
    pop       r2         
    pop       r1         
    pop       r10         
    add64i    sp, bp, 0  
    pop       bp         
    ret                  


