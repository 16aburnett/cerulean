    // --- Step 1: Handle Edge Cases (Zero and Negative) ---
    // Check if n == 0
    loada     r5, __builtin__print__i64__check_neg
    bne       r1, r0, r5 // If r1 != 0, branch to check_neg
    
    // If we didn't branch, n == 0. Print '0' and exit safely via epilogue.
    lli       r1, 48     // Load ASCII '0'
    putchar   r1         // Execute dedicated print instruction
    loada     r5, __builtin__print__i64__function_epilogue
    jmp       r5         

__builtin__print__i64__check_neg:
    // Check if n < 0
    loada     r5, __builtin__print__i64__prep_loops
    bge       r1, r0, r5 // If r1 >= 0, skip to prep_loops

    // If here, n < 0. Print '-' and negate r1 using 64-bit subtraction.
    mv64      r4, r0     // zero out r4
    lli       r4, 45     // Load ASCII '-'
    putchar   r4         
    sub64     r1, r0, r1 // CHANGED: r1 = r0 (0) - r1 (64-bit signed negation)

__builtin__print__i64__prep_loops:
    // Initialize loop tracking variables to zero using r0
    add64i    r2, r0, 0  // CHANGED: reversed = 0 (64-bit clean width)
    add64i    r3, r0, 0  // CHANGED: digit_count = 0 (64-bit clean width)
    add64i    r8, r0, 1  // Safe constant '1' for decrementing loop counters without negative immediates

// --- Step 2: Loop 1 (Reverse and Count Digits) ---
__builtin__print__i64__loop1_start:
    loada     r5, __builtin__print__i64__loop2_start
    beq       r1, r0, r5 // If n == 0, we are done reversing. Jump to printing loop.

    // reversed = reversed * 10
    mul64i    r2, r2, 10 // CHANGED: Multiply 64-bit reversed accumulator by 10

    // Extract lowest digit and divide n by 10 using 64-bit signed arithmetic
    modi64i   r4, r1, 10 // CHANGED: r4 = n % 10 (64-bit modulo)
    divi64i   r1, r1, 10 // CHANGED: r1 = n / 10 (64-bit division)

    // reversed = reversed + (n % 10)
    add64     r2, r2, r4 // CHANGED: Add extracted digit (64-bit addition)

    // digit_count++
    add32i    r3, r3, 1  // Increment loop counter
    
    loada     r5, __builtin__print__i64__loop1_start
    jmp       r5         

// --- Step 3: Loop 2 (Print Using Digit Count) ---
__builtin__print__i64__loop2_start:
    loada     r5, __builtin__print__i64__function_epilogue
    beq       r3, r0, r5 // If digit_count == 0, we are finished. Exit.

    // Extract next digit to print from reversed 64-bit accumulator
    modi64i   r4, r2, 10 // CHANGED: r4 = reversed % 10 (64-bit math)
    divi64i   r2, r2, 10 // CHANGED: reversed = reversed / 10 (64-bit math)

    // Convert integer value to ASCII character
    add32i    r4, r4, 48 // Convert single digit to ASCII character code

    putchar   r4         // Directly print character register

    // digit_count--
    sub32     r3, r3, r8 // CHANGED: r3 = r3 - r8(1) (Avoids immediate parser bug)
    
    loada     r5, __builtin__print__i64__loop2_start
    jmp       r5         

__builtin__print__i64__function_epilogue:
    pop       r9         
    pop       r8         
    pop       r7         
    pop       r6         
    pop       r5         
    pop       r4         
    pop       r3         
    pop       r2         
    pop       r1         
    pop       r10        
    add64i    sp, bp, 0  
    pop       bp         
    ret                  

