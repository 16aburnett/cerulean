    putchar   r4
    subf64    r1, r2, r1 // CHANGED: r1 = 0.0 - r1 (64-bit float negation)

__builtin__print__f64__extract_whole:
    // --- Step 2: Extract and Print Whole Number Integer Part ---
    cvtf64i64 r3, r1    // CHANGED: r3 = (i64_t)f using 64-bit conversion
    
    // Call your working integer printer routine using your stack convention
    push      r3         
    loada     r5, __builtin__print__i32
    call      r5         // Invoke print_int(3)
    pop       r3         

    // --- Step 3: Print Decimal Point ---
    add64i    r4, r0, 46  // Clear and load ASCII '.'
    putchar   r4

    // --- Step 4: Convert Fraction to a 6-digit Integer ---
    cvti64f64 r2, r3     // CHANGED: r2 = (double)int_part
    subf64    r1, r1, r2 // CHANGED: r1 = f - int_part (64-bit math)

    // Mathematically construct float 1000000.0 directly in r6 as a double
    add64i    r6, r0, 0  
    lui       r6, 15     
    lli       r6, 16960  // r6 = integer 1000000
    cvti64f64 r6, r6     // CHANGED: Convert integer 1000000 to double 1000000.0

    mulf64    r1, r1, r6 // CHANGED: r1 = frac * 1000000.0 (64-bit precision)
    cvtf64i64 r1, r1    // CHANGED: r1 = standard integer fraction (e.g., 140000)

    // Set up our single forward-extraction printing loop (integer space)
    add64i    r2, r0, 1     
    lui       r2, 1         
    lli       r2, 34464     // r2 = 100000 (Our forward division factor)
    
    add64i    r3, r0, 0     // Clear r3 completely
    lli       r3, 6         // r3 (loop counter) = 6 digits total
    add64i    r8, r0, 1     // Constant 1 for loop decrementing

// --- Step 5: Single Forward Digit Extraction Loop ---
__builtin__print__f64__print_loop:
    loada     r5, __builtin__print__f64__function_epilogue
    beq       r3, r0, r5    // After 6 prints, finish up

    // Extract the highest digit forward (Still uses 32-bit int math for speed)
    divu32    r4, r1, r2    // r4 = 140000 / 100000 = 1
    modu32    r1, r1, r2    // r1 = 140000 % 100000 = 40000

    // Print the isolated digit
    add32i    r4, r4, 48    // Convert to ASCII
    putchar   r4

