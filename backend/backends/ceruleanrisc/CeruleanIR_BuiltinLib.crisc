// Prints an int to the screen
// void print (int valueToPrint);
// valueToPrint : [rbp + 16]
__builtin__print__i32:
__builtin__print__i32__function_prologue:
    push      bp        // save caller's bp
    add64i    bp, sp, 0 // bp = sp
    push      r10        // save caller's r10
    push      r1        // save caller's r1
    push      r2        // save caller's r2
    push      r3        // save caller's r3
    push      r4        // save caller's r4
    push      r5        // save caller's r5
    push      r6        // save caller's r6
    push      r7        // save caller's r7
    push      r8        // save caller's r8
    push      r9        // save caller's r9

    // Load arguments
    load64 r1, bp, 16    // read num

    // --- Step 1: Handle Edge Cases (Zero and Negative) ---
    // Check if n == 0
    loada r5, __builtin__print__i32__check_neg       // Load address of check_neg label
    bne r1, r0, r5            // If r1 != 0, branch to check_neg
    
    // If we didn't branch, n == 0. Print '0' and exit.
    lli r1, 48                // Load ASCII '0'
    putchar r1                // Execute dedicated print instruction
    loada       r5, __builtin__print__i32__function_epilogue
    jmp         r5            // Exit routine

__builtin__print__i32__check_neg:
    // Check if n < 0
    loada r5, __builtin__print__i32__prep_loops      // Load address of prep_loops label
    bge r1, r0, r5            // If r1 >= 0, skip to prep_loops

    // If here, n < 0. Print '-' and negate r1.
    lli r4, 45                // Load ASCII '-' into scratchpad
    putchar r4                // Print '-'
    
    // Negate: r1 = 0 - r1
    sub32 r1, r0, r1          // r1 = r0 (0) - r1

__builtin__print__i32__prep_loops:
    // Initialize loop tracking variables to zero using r0
    add32i r2, r0, 0          // reversed = 0
    add32i r3, r0, 0          // digit_count = 0

// --- Step 2: Loop 1 (Reverse and Count Digits) ---
__builtin__print__i32__loop1_start:
    loada r5, __builtin__print__i32__loop2_start     // Load address of loop 2 exit target
    beq r1, r0, r5            // If n == 0, we are done reversing. Jump to printing.

    // reversed = reversed * 10
    mul32i r2, r2, 10         // Multiply reversed accumulator by 10

    // Extract lowest digit and divide n by 10
    modi32i r4, r1, 10        // r4 = n % 10
    divi32i r1, r1, 10        // r1 = n / 10

    // reversed = reversed + (n % 10)
    add32 r2, r2, r4          // Add extracted digit to reversed accumulator

    // digit_count++
    add32i r3, r3, 1          // Increment digit counter
    
    loada r5, __builtin__print__i32__loop1_start     // Load head of loop 1 address
    jmp r5                    // Repeat loop 1

// --- Step 3: Loop 2 (Print Using Digit Count) ---
__builtin__print__i32__loop2_start:
    loada r5, __builtin__print__i32__function_epilogue // Load routine exit address
    beq r3, r0, r5            // If digit_count == 0, we are finished. Exit.

    // Extract next digit to print from reversed number
    modi32i r4, r2, 10        // r4 = reversed % 10
    divi32i r2, r2, 10        // reversed = reversed / 10

    // Convert integer value to ASCII character
    add32i r4, r4, 48         // Add 48 (ASCII '0')

    putchar r4                // Directly print the character register

    // digit_count--
    add32i r3, r3, -1         // Decrement remaining digit counter
    
    loada r5, __builtin__print__i32__loop2_start     // Load head of loop 2 address
    jmp r5                    // Repeat loop 2

__builtin__print__i32__function_epilogue:
    pop       r9         // restore caller's r9
    pop       r8         // restore caller's r8
    pop       r7         // restore caller's r7
    pop       r6         // restore caller's r6
    pop       r5         // restore caller's r5
    pop       r4         // restore caller's r4
    pop       r3         // restore caller's r3
    pop       r2         // restore caller's r2
    pop       r1         // restore caller's r1
    pop       r10         // restore caller's r10 
    add64i    sp, bp, 0  // sp = bp ; remove local vars 
    pop       bp         // bp = [sp] ; restore caller bp
    ret                  // return from function

