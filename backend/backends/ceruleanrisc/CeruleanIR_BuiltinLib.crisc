// Prints a pointer address to the screen in hexadecimal
// void print (ptr valueToPrint);
// valueToPrint : [rbp + 16]

__builtin__print__ptr:
__builtin__print__ptr__function_prologue:
    push      bp        // save caller's bp
    add64i    bp, sp, 0 // bp = sp
    push      r10       // save caller's r10
    push      r1        // save caller's r1
    push      r2        // save caller's r2
    push      r3        // save caller's r3
    push      r4        // save caller's r4
    push      r5        // save caller's r5
    push      r6        // save caller's r6
    push      r7        // save caller's r7
    push      r8        // save caller's r8
    push      r9        // save caller's r9

    // Load the 64-bit pointer address from the stack slot
    load64    r1, bp, 16 // r1 = 64-bit memory address

    // --- Step 1: Print the standard "0x" Hex Prefix ---
    add64i    r4, r0, 48   // Load ASCII '0'
    putchar   r4
    add64i    r4, r0, 120  // Load ASCII 'x'
    putchar   r4

    // --- Step 2: Initialize Loop Counters ---
    add64i    r2, r0, 0    // r2 (reversed accumulator) = 0
    add64i    r3, r0, 0    // Clear loop tracker
    lli       r3, 16       // r3 (loop counter) = 16 characters total
    add64i    r8, r0, 1    // Safe constant '1' for decrementing
    add64i    r9, r0, 10   // Safe constant '10' for threshold checks

// --- Step 3: Loop 1 (Reverse Exactly 16 Nibbles via Unsigned Math) ---
__builtin__print__ptr__reverse_loop:
    loada     r5, __builtin__print__ptr__print_prep
    beq       r3, r0, r5   // After 16 iterations, head to the print prep

    mul64i    r2, r2, 16   // reversed = reversed * 16
    modu64i   r4, r1, 16   // r4 = address % 16 (Extract lowest 4 bits natively)
    divu64i   r1, r1, 16   // address = address / 16 (Slide address right 4 bits)
    add64     r2, r2, r4   // reversed = reversed + nibble

    sub32     r3, r3, r8   // loop_counter-- (r3 = r3 - 1)
    loada     r5, __builtin__print__ptr__reverse_loop
    jmp       r5

__builtin__print__ptr__print_prep:
    lli       r3, 16       // Reset loop counter back to 16 for printing forward

// --- Step 4: Loop 2 (Print Exactly 16 Hex Characters Forward) ---
__builtin__print__ptr__print_loop:
    loada     r5, __builtin__print__ptr__function_epilogue
    beq       r3, r0, r5   // After 16 prints, finish up

    modu64i   r4, r2, 16   // Extract the next highest hex nibble to print
    divu64i   r2, r2, 16   // Shift reversed register down for next cycle

    // Check if the nibble numeric value is 0-9 or 10-15 (a-f)
    lt        r7, r4, r9   // r7 = (r4 < 10) ? 1 : 0
    loada     r5, __builtin__print__ptr__alpha
    beq       r7, r0, r5   // If r4 >= 10, jump to alphabet conversion

    // Numeric conversion: 0-9 -> ASCII '0'-'9'
    add32i    r4, r4, 48 
    loada     r5, __builtin__print__ptr__output
    jmp       r5

__builtin__print__ptr__alpha:
    // Alphabetic conversion: 10-15 -> ASCII 'a'-'f'
    sub32     r4, r4, r9   // r4 = r4 - 10 (Safe subtraction bypassing immediate bug)
    add32i    r4, r4, 97   // r4 = r4 + 'a' (ASCII 97)

__builtin__print__ptr__output:
    putchar   r4           // Directly print hex character from register

    sub32     r3, r3, r8   // loop_counter-- (r3 = r3 - 1)
    loada     r5, __builtin__print__ptr__print_loop
    jmp       r5

__builtin__print__ptr__function_epilogue:
    pop       r9         
    pop       r8         
    pop       r7         
    pop       r6         
    pop       r5         
    pop       r4         
    pop       r3         
    pop       r2         
    pop       r1         
    pop       r10        
    add64i    sp, bp, 0  
    pop       bp         
    ret                  

