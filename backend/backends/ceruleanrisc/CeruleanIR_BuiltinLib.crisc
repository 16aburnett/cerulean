// // Prints a char to the screen
// // Utilizes printf "%c"
// // void print (char valueToPrint);
// // valueToPrint : [rbp + 16]
__builtin__print__char:
        // function prologue - this is prolly overkill
        push bp
        mv64 bp, sp
        push r1 // Saving caller's r1
        // function body
        load64 r1, bp, 16 // r1 <- [bp + 16]
        putchar r1
        // function epilogue - this is prolly overkill
        pop r1 // Restoring caller's r1
        mv64 sp, bp
        pop bp
        ret

