// Super simple Hello World CeruleanRISC Program
// Main is where the program starts executing from (and must be global)
    @global main
main:
    lli       r1, 'H'
    putchar   r1
    lli       r1, 'e'
    putchar   r1
    lli       r1, 'l'
    putchar   r1
    lli       r1, 'l'
    putchar   r1
    lli       r1, 'o'
    putchar   r1
    lli       r1, ','
    putchar   r1
    lli       r1, ' '
    putchar   r1
    lli       r1, 'W'
    putchar   r1
    lli       r1, 'o'
    putchar   r1
    lli       r1, 'r'
    putchar   r1
    lli       r1, 'l'
    putchar   r1
    lli       r1, 'd'
    putchar   r1
    lli       r1, '!'
    putchar   r1
    lli       r1, '\n'
    putchar   r1
    halt
