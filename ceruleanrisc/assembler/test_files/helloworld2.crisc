// Simple Hello World with data directives
letsgoooo:
string_addr:
    .ascii "Hello, World!\n"
    .f32 3.1415
    .i64 1337
    .addr main
    .i8 16

// This should be correctly aligned, despite above not ending at a 32bit alignment
    @global main
main:
    // Load string_addr into r1
    // Currently this takes 6 instructions
    lui       r1, %hi(string_addr)
    lli       r1, %mh(string_addr)
    sll64i    r1, r1, 16
    lli       r1, %ml(string_addr)
    sll64i    r1, r1, 16
    lli       r1, %lo(string_addr)

    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    add64i    r1, r1, 1
    load8     r2, r1, 0
    putchar   r2
    ret
